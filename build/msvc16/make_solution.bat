@echo off

set "CONFIGURATION=%1"

set "VERSION=16"
set "YEAR=2019"

set "BUILD_SOLUTION_DIR=%~dp0..\..\solutions\solution_msvc%VERSION%\%CONFIGURATION%"

@mkdir "%BUILD_SOLUTION_DIR%"
@pushd "%BUILD_SOLUTION_DIR%"

@call CMake -G "Visual Studio %VERSION% %YEAR%" -A Win32 -S "%~dp0..\.." -DCMAKE_CONFIGURATION_TYPES:STRING=%CONFIGURATION% -DCMAKE_BUILD_TYPE:STRING=%CONFIGURATION% -DLIBMOVIE_EXAMPLES_BUILD:BOOL=TRUE -DLIBMOVIE_TEST:BOOL=TRUE

@popd